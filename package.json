{
  "name": "dsh-redo-live",
  "version": "0.1.0",
  "description": "Edit a sent message and regenerate in place even while the answer is still streaming: it stops the running turn via Session.cancel, waits for idle, then rewinds. Fork of dsh-redo. 生成中也能编辑/重发已发送的消息：点编辑先自动停掉在跑的回合。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "edit-message",
    "message-edit",
    "edit-while-generating",
    "edit-while-streaming",
    "edit-during-response",
    "streaming",
    "regenerate",
    "resend",
    "rewind",
    "interrupt",
    "cancel",
    "stop-then-resend",
    "chat-ui",
    "chatgpt-style",
    "codex-style",
    "deepseek",
    "fork",
    "生成中编辑",
    "边生成边改",
    "重新生成",
    "编辑重发"
  ],
  "license": "MIT",
  "author": "tanxiaolong",
  "contributors": [
    {
      "name": "Imzl-zl",
      "url": "https://github.com/Imzl-zl",
      "comment": "原作者：上游 dsh-redo（MIT）"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanxiaolong/dsh-redo-live.git"
  },
  "homepage": "https://github.com/tanxiaolong/dsh-redo-live#readme",
  "bugs": {
    "url": "https://github.com/tanxiaolong/dsh-redo-live/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
